.gradle/
**/build/
android-client/.gradle/
android-client/build/
android-client/app/build/
android-client/local.properties
android-client/.cxx/
*.apk
*.aab

# Android Studio / IntelliJ IDEA
.idea/
*.iml
.navigation/
captures/
output-metadata.json

# If you want to completely exclude the android-client folder, uncomment below:
# android-client/

